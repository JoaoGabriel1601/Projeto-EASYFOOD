{
  "name": "projeto-easyfood-aula1",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:studio": "node node_modules/prisma/build/index.js studio --browser none",
    "test:unit": "node --test tests/auth.unit.test.js",
    "test:integration": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "EasyFood - API em camadas com PostgreSQL, Prisma e autenticacao JWT",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3"
  },
  "engines": {
    "node": ">=22"
  }
}
